{
 "title": "Claude Code: same Short, three tools",
 "uid": "video-builds",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "bargauge",
   "title": "Tokens per build (same Short, three tools)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (lab_tool, lab_run) (max_over_time(claude_code_token_usage_tokens_total{lab_tool!=\"smoke\"}[$__range]))",
     "legendFormat": "{{lab_tool}} run {{lab_run}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true
   }
  },
