     "expr": "sum by (query_source) (sum_over_time({service_name=\"claude-code\"} | lab_arm=~\"$arm\" | event_name=\"api_request\" | label_format read=`{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}` | unwrap read [$__interval]))",
