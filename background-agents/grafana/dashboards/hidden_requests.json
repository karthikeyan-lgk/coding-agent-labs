  {
   "id": 4,
   "type": "logs",
   "title": "Every status label: tokens read \u2192 tokens written",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=\"claude-code\"} | lab_arm=~\"$arm\" | event_name=\"api_request\" | query_source=\"agent_summary\" | label_format read=`{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}` | line_format `agent_summary \u00b7 read {{ .read }} tokens \u2192 wrote {{ .output_tokens }} \u00b7 ${{ printf \"%.3f\" (divf .cost_usd 1) }}`"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Ascending",
    "enableLogDetails": false,
    "dedupStrategy": "none"
   }
  }
 ]
