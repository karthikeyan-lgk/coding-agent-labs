{
 "uid": "claude-hidden-requests",
 "title": "Claude Code: requests you didn't type",
 "schemaVersion": 41,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "arm",
    "type": "custom",
    "query": "interactive-long,interactive,suggest-on,suggest-off",
    "current": {
     "text": "interactive-long",
     "value": "interactive-long"
    },
    "options": [],
    "includeAll": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "bargauge",
   "title": "Spend by query_source (Claude Code's own cost estimate)",
   "description": "Every model request is an api_request event; query_source says who asked for it.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (query_source) (sum_over_time({service_name=\"claude-code\"} | lab_arm=~\"$arm\" | event_name=\"api_request\" | unwrap cost_usd [$__interval]))",
     "queryType": "range",
     "legendFormat": "{{query_source}}"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "top",
    "sizing": "manual",
    "reduceOptions": {
     "calcs": [
      "sum"
     ],
     "fields": "",
     "values": false
    },
    "legend": {
     "showLegend": false
    },
    "minVizHeight": 30,
    "maxVizHeight": 60,
    "text": {
     "titleSize": 22,
     "valueSize": 24
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 3,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3ec7d4"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "agent_summary"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8743b"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "prompt_suggestion"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#a371f7"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "repl_main_thread"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8b98a8"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "generate_session_title"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3fb950"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "agent:builtin:general-purpose"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3ec7d4"
        }
       }
      ]
     }
    ]
   },
   "interval": "1m",
   "transformations": []
  },
  {
   "id": 2,
   "type": "bargauge",
   "title": "Tokens by query_source (input + cache read + cache write)",
   "description": "",
